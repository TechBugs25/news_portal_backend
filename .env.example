# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Configuration (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=news_portal_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_news_portal_2026_secure
JWT_EXPIRES_IN=1h

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Uploads
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Default Admin Seeding
AUTO_SEED_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@newsportal.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
